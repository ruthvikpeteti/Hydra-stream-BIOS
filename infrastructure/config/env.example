# Template of infrastructure/.env. Do NOT copy this file: scripts/init-cluster-ids.sh generates the real one (git-ignored) with unique
# cluster ids and random secrets, and keeps existing values. Names only here.
CLUSTER_ID_A=                  # KRaft cluster id of region A  (unique per region, never reused)
CLUSTER_ID_B=
CLUSTER_ID_C=
SS_GATEWAY_API_KEY=            # client key for the gateways (X-API-Key)
POSTGRES_PASSWORD=
SS_POLICY_ADMIN_KEY=           # policy engine roles: admin / writer / service
SS_POLICY_WRITER_KEY=
SS_POLICY_SERVICE_KEY=
SS_REPL_KEY_A=                 # one replication-agent credential per source region
SS_REPL_KEY_B=
SS_REPL_KEY_C=
SS_DASH_VIEWER_TOKEN=          # dashboard sign-in tokens
SS_DASH_OPERATOR_TOKEN=

# Optional runtime settings (defaults in the Compose files)
# SS_LEASE_TTL_MS=6000                 gateway write lease (DR overlay); the controller waits TTL + 1 s after fencing
# SS_DR_ALLOW_DEGRADED_RPO=0           1 lets an operator approve promoting a replica outside its RPO (default: forbidden)
# SS_DR_AUTO=1                         0 disables automatic failover (the controllers still report)
# SS_DR_FAIL_AFTER=3 SS_DR_RECOVER_AFTER=3   consecutive probes to declare a region failed / recovered
# SS_DR_FAULTS=1                       test-only fault injection endpoints of the controller (set 0 outside development)
# SS_FAULT_INJECTION=1                 test-only fault endpoint of the replication receivers (set 0 outside development)
# SS_ROUTE_*, SS_BREAKER_*             routing observation window, hysteresis, cooldown, circuit breaker (ROUTING.md)
